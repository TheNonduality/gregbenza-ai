---
import YouTube from './YouTube.astro';

// Renders a media object from project frontmatter natively — image, video, or a
// clean YouTube embed. One component so every project handles media the same way.
interface Props {
  type: 'image' | 'video' | 'youtube';
  src: string;
  alt?: string;
  caption?: string;
  poster?: string;
}
const { type, src, alt = '', caption, poster } = Astro.props;

// Convention: <name>.web.mp4 ships beside <name>.poster.jpg. iOS Safari needs
// an explicit source type and a poster, or the player renders blank.
const posterSrc = poster ?? (src.endsWith('.web.mp4') ? src.replace(/\.web\.mp4$/, '.poster.jpg') : undefined);
---

{type === 'youtube' && <YouTube id={src} title={caption ?? alt} />}

{
  type === 'image' && (
    <figure>
      <img src={src} alt={alt} loading="lazy" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

{
  type === 'video' && (
    <figure>
      <video controls preload="metadata" playsinline muted poster={posterSrc}>
        <source src={src} type="video/mp4" />
      </video>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}
