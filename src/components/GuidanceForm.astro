---
// "Offer guidance" — the feedback door. A quiet button that unfolds a small
// form. Anonymous by default; the post slug rides along as a hidden field so
// guidance arrives tagged with what it's about.
//
// Posts to our own function at /api/guidance, NOT to Netlify Forms. Netlify
// Forms accepted every submission and stored none of them — confirmed
// 2026-07-25 across four tests including Greg's own phone. See
// netlify/functions/guidance.mjs for the full account.
interface Props {
  context?: string; // which page/post this guidance is about
}
const { context = 'site' } = Astro.props;
---

<details class="guidance">
  <summary class="guidance-btn">Offer guidance</summary>
  <form name="guidance" method="POST" action="/api/guidance" class="guidance-form">
    <input type="hidden" name="context" value={context} />
    {/* Honeypot: off-screen rather than display:none, because bots skip what
        is hidden outright. tabindex and autocomplete keep real people — and
        their password managers — from ever landing in it by accident. */}
    <p class="hp" aria-hidden="true">
      <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>
    <label class="g-label">
      What should be different?
      <textarea name="message" rows="4" required placeholder="Poke a hole, point a direction, tell me what to build differently."></textarea>
    </label>
    <label class="g-label">
      Name or contact <span class="g-optional">(optional — anonymous is fine)</span>
      <input type="text" name="from" autocomplete="off" />
    </label>
    <button type="submit" class="g-send">Send it</button>
  </form>
</details>

<style>
  .guidance {
    display: inline-block;
  }
  /* The one solid fill on the site. Every other control is an outline, so this
     reads as the single thing the site is actually asking you to press — and it
     gets there on contrast alone rather than on a colour, so it never argues
     with the room it happens to be standing in. */
  /* Geometry deliberately IDENTICAL to .ask-btn — same type, same size, same
     padding, same height, same radius. It was set in the display face a step
     larger with wider ends, which next to a row of Inter pills read as a
     different kind of object rather than the same object turned up. Only ONE
     property distinguishes it now: it is filled. That is enough, because it is
     the only filled control on the site.
     Touch height is handled once for every pill in global.css. */
  .guidance-btn {
    list-style: none;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--on-press);
    background: var(--press);
    border: 1.5px solid var(--press);
    border-radius: var(--radius-pill);
    padding: 0.25em 0.85em;
    min-height: 2.1rem;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .guidance-btn::-webkit-details-marker {
    display: none;
  }
  .guidance-btn:hover,
  .guidance[open] .guidance-btn {
    background: var(--press-hover);
    border-color: var(--press-hover);
  }
  .guidance-form {
    margin-top: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ground-raised);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 28rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .g-label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-soft);
  }
  .g-optional {
    font-weight: 400;
    color: var(--text-faint);
  }
  .guidance-form textarea,
  .guidance-form input[type='text'] {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text);
    background: var(--ground);
    border: 1.5px solid var(--line);
    border-radius: 8px;
    padding: 0.55em 0.7em;
  }
  .guidance-form textarea:focus,
  .guidance-form input[type='text']:focus {
    border-color: var(--press);
  }
  .g-send {
    align-self: flex-start;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--on-press);
    background: var(--press);
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.5em 1.4em;
    min-height: 44px;
    cursor: pointer;
  }
  .g-send:hover {
    background: var(--press-hover);
  }
</style>
