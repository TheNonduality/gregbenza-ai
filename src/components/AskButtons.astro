---
// The ask-more row: hands a markdown record to the visitor's own AI, prompt
// preloaded. Data-driven on purpose — prefill support breaks without notice
// (Copilot did), so a service is one edit to add or demote. ChatGPT and
// Perplexity auto-submit on open; the prompt stays short, tame, and visible.
//
// Two presentations, one prompt: pills inline on wide screens, and a single
// pill that unfolds a panel on phones. No horizontal scrolling, ever.
interface Props {
  agentMd?: string;
  title?: string;
  prompt?: string;
  label?: string;
  collapsed?: boolean; // always the single-pill presentation (used by the header)
  summaryLabel?: string;
}
const {
  agentMd,
  title,
  prompt: promptOverride,
  label = 'Ask your AI about this',
  collapsed = false,
  summaryLabel = 'Ask your AI ↗',
} = Astro.props;

const SITE = 'https://gregbenza.ai';
const prompt =
  promptOverride ??
  `Read ${SITE}${agentMd} — Greg Benza's record of "${title}". Tell me the story of how it went, then let's discuss how to apply the method.`;
const q = encodeURIComponent(prompt);

const services = [
  { name: 'Claude', href: `https://claude.ai/new?q=${q}` },
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}` },
];
---

<div class:list={['ask', collapsed && 'ask-collapsed']} data-prompt={prompt}>
  {!collapsed && (
    <div class="ask-wide">
      {label && <span class="ask-label">{label}</span>}
      {services.map((s) => (
        <a class="ask-btn" href={s.href} target="_blank" rel="noopener">{s.name} ↗</a>
      ))}
      <button class="ask-btn ask-copy" type="button">Copy prompt</button>
    </div>
  )}

  <details class="ask-narrow">
    <summary class="ask-btn ask-summary">{summaryLabel}</summary>
    <div class="ask-panel">
      {services.map((s) => (
        <a class="ask-panel-item" href={s.href} target="_blank" rel="noopener">{s.name} ↗</a>
      ))}
      <button class="ask-panel-item ask-copy" type="button">Copy prompt</button>
    </div>
  </details>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.ask').forEach((row) => {
    row.querySelectorAll<HTMLButtonElement>('.ask-copy').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        await navigator.clipboard.writeText(row.dataset.prompt ?? '');
        const old = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = old), 1500);
      });
    });
  });
</script>

<style>
  .ask {
    display: contents;
  }
  .ask-wide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .ask-label {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-right: 0.2rem;
    white-space: nowrap;
  }
  .ask-btn {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink);
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.25em 0.8em;
    text-decoration: none;
    cursor: pointer;
    min-height: 2.1rem;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .ask-btn:hover {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--paper-edge);
  }
  .ask-narrow {
    display: none;
    position: relative;
  }
  .ask-summary {
    list-style: none;
  }
  .ask-summary::-webkit-details-marker {
    display: none;
  }
  .ask-narrow[open] .ask-summary {
    border-color: var(--ink);
    color: var(--ink);
  }
  .ask-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    z-index: 20;
    min-width: 11rem;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 0.25rem;
    box-shadow: 0 4px 14px rgba(26, 26, 26, 0.12);
  }
  .ask-panel-item {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--ink);
    background: none;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0.6rem 0.75rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }
  .ask-panel-item:hover {
    background: var(--paper-edge);
    color: var(--ink);
  }
  /* The header asks in one pill at every width. */
  .ask-collapsed .ask-narrow {
    display: block;
  }
  .ask-collapsed .ask-panel {
    left: auto;
    right: 0;
  }
  /* Phones: one pill, panel unfolds. Nothing scrolls sideways. */
  @media (max-width: 700px) {
    .ask-wide {
      display: none;
    }
    .ask-narrow {
      display: block;
    }
  }
</style>
