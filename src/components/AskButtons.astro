---
// The ask-more row: hands a markdown record to the visitor's own AI, prompt
// preloaded. Data-driven on purpose — prefill support breaks without notice
// (Copilot did), so a service is one edit to add or demote. ChatGPT and
// Perplexity auto-submit on open; the prompt stays short, tame, and visible.
//
// Two presentations, one prompt: pills inline on wide screens, and a single
// pill that unfolds a panel on phones. No horizontal scrolling, ever.
interface Props {
  agentMd?: string;
  title?: string;
  prompt?: string;
  label?: string;
  collapsed?: boolean; // always the single-pill presentation (used by the header)
  summaryLabel?: string;
}
const {
  agentMd,
  title,
  prompt: promptOverride,
  label = 'Ask your AI about this',
  collapsed = false,
  summaryLabel = 'Ask your AI ↗',
} = Astro.props;

const SITE = 'https://gregbenza.ai';
const prompt =
  promptOverride ??
  `Read ${SITE}${agentMd} — Greg Benza's record of "${title}". Tell me the story of how it went, then let's discuss how to apply the method.`;
const q = encodeURIComponent(prompt);

const services = [
  { name: 'Claude', href: `https://claude.ai/new?q=${q}` },
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}` },
];
---

{/* The spark. Two chat-corner brackets around a four-point star: the site's one
    repeated mark, and it belongs to this handshake alone. It is drawn in
    currentColor so it inherits whatever the control it sits in is wearing.
    Deliberately absent from the copy buttons — the copy script swaps their
    textContent, which would delete an inline SVG child on first press. */}
<div class:list={['ask', collapsed && 'ask-collapsed']} data-prompt={prompt}>
  {!collapsed && (
    <div class="ask-wide">
      {label && (
        <span class="ask-label">
          <svg class="ask-spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 4 3 12l4 8" />
            <path d="M17 4l4 8-4 8" />
            <path d="M12 8.5l1.3 2.2 2.2 1.3-2.2 1.3L12 15.5l-1.3-2.2L8.5 12l2.2-1.3z" />
          </svg>
          {label}
        </span>
      )}
      {services.map((s) => (
        <a class="ask-btn" href={s.href} target="_blank" rel="noopener">{s.name} ↗</a>
      ))}
      <button class="ask-btn ask-copy" type="button">Copy prompt</button>
    </div>
  )}

  <details class="ask-narrow">
    <summary class="ask-btn ask-summary">
      <svg class="ask-spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M7 4 3 12l4 8" />
        <path d="M17 4l4 8-4 8" />
        <path d="M12 8.5l1.3 2.2 2.2 1.3-2.2 1.3L12 15.5l-1.3-2.2L8.5 12l2.2-1.3z" />
      </svg>
      {summaryLabel}
    </summary>
    <div class="ask-panel">
      {services.map((s) => (
        <a class="ask-panel-item" href={s.href} target="_blank" rel="noopener">{s.name} ↗</a>
      ))}
      <button class="ask-panel-item ask-copy" type="button">Copy prompt</button>
    </div>
  </details>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.ask').forEach((row) => {
    row.querySelectorAll<HTMLButtonElement>('.ask-copy').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        await navigator.clipboard.writeText(row.dataset.prompt ?? '');
        const old = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = old), 1500);
      });
    });
  });
</script>

<style>
  .ask {
    display: contents;
  }
  .ask-wide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .ask-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-right: 0.2rem;
    white-space: nowrap;
  }
  /* The mark. Stroked, not filled, so it reads at 14px and inherits colour. */
  .ask-spark {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--ask);
  }
  /* Every ask control wears the same cyan outline — the visitor learns the
     colour once and recognises the handshake everywhere it appears. */
  .ask-btn {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    background: none;
    border: 1.5px solid var(--ask-line);
    border-radius: var(--radius-pill);
    padding: 0.25em 0.85em;
    gap: 0.35rem;
    text-decoration: none;
    cursor: pointer;
    min-height: 2.1rem;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }
  .ask-btn:hover {
    border-color: var(--ask);
    color: var(--text);
    background: var(--ask-tint);
  }
  .ask-narrow {
    display: none;
    position: relative;
  }
  .ask-summary {
    list-style: none;
  }
  .ask-summary::-webkit-details-marker {
    display: none;
  }
  .ask-narrow[open] .ask-summary {
    border-color: var(--ask);
    background: var(--ask-tint);
  }
  .ask-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    z-index: 20;
    min-width: 11rem;
    display: flex;
    flex-direction: column;
    background: var(--ground-raised);
    border: 1px solid var(--ask-line);
    border-radius: var(--radius);
    padding: 0.25rem;
    box-shadow: var(--shadow);
  }
  .ask-panel-item {
    font-size: 0.9rem;
    color: var(--text);
    background: none;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0.6rem 0.75rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }
  .ask-panel-item:hover {
    background: var(--ask-tint);
    color: var(--text);
  }
  /* The header asks in one pill at every width. */
  .ask-collapsed .ask-narrow {
    display: block;
  }
  .ask-collapsed .ask-panel {
    left: auto;
    right: 0;
  }
  /* Phones: one pill, panel unfolds. Nothing scrolls sideways. */
  @media (max-width: 700px) {
    .ask-wide {
      display: none;
    }
    .ask-narrow {
      display: block;
    }
  }
</style>
