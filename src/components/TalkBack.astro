---
// "The door swings both ways" — the talk-back moment.
//
// The site's whole premise is that visitors steer the work. A lone button at the
// bottom of a page states that quietly enough to be missed, so this section says
// it out loud and gives the button a room of its own. It wraps GuidanceForm
// without touching it: the form, its action, and its honeypot are unchanged.
import GuidanceForm from './GuidanceForm.astro';

interface Props {
  /** Which page or post this guidance is about. Passed straight through. */
  context?: string;
}
const { context = 'site' } = Astro.props;
---

<section class="talkback reveal" aria-labelledby="talkback-title">
  <p class="eyebrow">The door swings both ways</p>
  <h2 id="talkback-title">Tell me what to build differently</h2>
  <p class="talkback-body">
    Poke a hole in it. Point a direction. Say what you would have done instead.
    This exhibit gets steered by the people walking through it — anonymous is
    fine, and everything sent here gets read.
  </p>
  <GuidanceForm context={context} />
</section>

<style>
  /* NO overflow:hidden here either — the form unfolds and must be free to grow. */
  .talkback {
    margin-block: var(--space-5);
    padding: var(--space-4) var(--space-3);
    background: var(--ground-raised);
    border: 1px solid var(--line);
    border-left: 5px solid var(--press);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .talkback h2 {
    margin-block: 0.2rem var(--space-2);
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
  }
  .talkback-body {
    max-width: 36rem;
    color: var(--text-soft);
    margin-block: 0 var(--space-3);
  }
</style>
