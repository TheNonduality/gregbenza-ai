---
// Clean YouTube embed — a lightweight facade, no third-party script, no cookies
// until the visitor clicks. Renders the thumbnail with a play button; clicking
// swaps in the real iframe. Restraint over convenience: this ships zero tracking
// weight on load and still gives a native embed.
interface Props {
  id: string;
  title?: string;
}
const { id, title = 'YouTube video' } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<figure class="yt">
  <lite-youtube data-id={id} data-title={title} style={`background-image:url('${thumb}')`}>
    <button type="button" class="yt-play" aria-label={`Play: ${title}`}>
      <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <path class="yt-shape" d="M66.5 7.7c-.8-2.9-2.5-4.6-5.4-5.4C55.8 1 34 1 34 1S12.2 1 6.9 2.3C4 3.1 2.3 4.8 1.5 7.7.2 13 0 24 0 24s.2 11 1.5 16.3c.8 2.9 2.5 4.6 5.4 5.4C12.2 47 34 47 34 47s21.8 0 27.1-1.3c2.9-.8 4.6-2.5 5.4-5.4C67.8 35 68 24 68 24s-.2-11-1.5-16.3z"></path>
        <path d="M45 24 27 14v20z" fill="#fff"></path>
      </svg>
    </button>
  </lite-youtube>
</figure>

<style>
  .yt { margin: var(--space-3) 0; }
  lite-youtube {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #000;
    background-position: center;
    background-size: cover;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
  }
  .yt-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  /* A fixed near-black, not a theme token: this shape sits on a video thumbnail,
     which is an arbitrary photograph rather than the wall, and the play triangle
     inside it is hard-coded white. Following --text would turn the shape white
     in dark mode and swallow the triangle whole. */
  .yt-shape { fill: #16161a; opacity: 0.86; transition: opacity 0.15s; }
  lite-youtube:hover .yt-shape { opacity: 1; }
  lite-youtube iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  // Progressive enhancement: click loads the real embed. No script runs for
  // YouTube until the visitor asks for it.
  customElements.define(
    'lite-youtube',
    class extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', () => this.activate(), { once: true });
      }
      activate() {
        if (this.querySelector('iframe')) return;
        const id = this.dataset.id;
        const iframe = document.createElement('iframe');
        iframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('title', this.dataset.title || 'YouTube video');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        // Size the iframe inline, not via the component's scoped CSS: this iframe
        // is created at runtime and never gets Astro's scope marker, so the scoped
        // `lite-youtube iframe` rule would skip it and it would render at the
        // browser default (~300x150) in the corner. Inline styles are immune to that.
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
        this.replaceChildren(iframe);
      }
    }
  );
</script>
