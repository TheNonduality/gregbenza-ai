---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AskButtons from '../components/AskButtons.astro';
import GuidanceForm from '../components/GuidanceForm.astro';
import { SITE_URL, PERSON_ID, BLOG_ID, person, blog, graph } from '../lib/schema';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Filter chips come from the posts themselves — one chip per project lineage.
const lineages = [...new Set(projects.map((p) => p.data.project).filter(Boolean))] as string[];
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Structured data: who made this (Person), what this page is (Blog), and what
// it holds (the post list). Posts repeat the same @ids so crawlers stitch the
// graph together across pages.
const jsonLd = graph([
  person,
  {
    ...blog,
    blogPost: projects.map((p) => ({
      '@type': 'BlogPosting',
      '@id': `${SITE_URL}/projects/${p.id}/#post`,
      headline: p.data.title,
      url: `${SITE_URL}/projects/${p.id}/`,
      datePublished: p.data.date.toISOString(),
      dateModified: (p.data.updated ?? p.data.date).toISOString(),
      author: { '@id': PERSON_ID },
    })),
  },
  {
    '@type': 'WebPage',
    '@id': `${SITE_URL}/#webpage`,
    url: `${SITE_URL}/`,
    name: 'GregBenza.AI — where good ideas go to grow',
    isPartOf: { '@id': BLOG_ID },
    about: { '@id': PERSON_ID },
    inLanguage: 'en',
  },
]);
---

<Base title="GregBenza.ai — where good ideas go to grow" jsonLd={jsonLd}>
  {/* The page's one h1. Words borrowed from the header and <title> — no new
      voice invented here; the design pass owns how loud this reads. */}
  <h1 class="page-title">GregBenza.AI — where good ideas go to grow</h1>

  {/* Filter chips — quiet by default (showing everything); ink when pressed. */}
  {
    lineages.length > 0 && (
      <nav class="chips" aria-label="Filter by project">
        <button class="chip chip-all is-active" data-project="">All</button>
        {lineages.map((name) => (
          <button class="chip" data-project={slugify(name)}>
            {name}
          </button>
        ))}
      </nav>
    )
  }

  {/* THE LOG — every post is a placard, newest first. */}
  {
    projects.length === 0 ? (
      <p>Nothing here yet — the census fills this in.</p>
    ) : (
      <div class="feed">
        {projects.map((p) => (
          <article class="placard" data-project={p.data.project ? slugify(p.data.project) : ''}>
            <a class="placard-link" href={`/projects/${p.id}/`}>
              {p.data.hero && p.data.hero.type === 'image' && (
                <img class="placard-media" src={p.data.hero.src} alt={p.data.hero.alt ?? ''} loading="lazy" />
              )}
              {p.data.hero && p.data.hero.type === 'video' && (
                <img
                  class="placard-media"
                  src={p.data.hero.src.replace(/\.web\.mp4$/, '.poster.jpg')}
                  alt={p.data.hero.caption ?? ''}
                  loading="lazy"
                />
              )}
              <div class="placard-body">
                <div class="placard-top">
                  <h2 class="placard-title">{p.data.title}</h2>
                  <time datetime={p.data.date.toISOString()}>
                    {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                </div>
                <p class="placard-headline">{p.data.blurb}</p>
                {p.data.project && <span class="placard-tag">{p.data.project}</span>}
              </div>
            </a>
            <div class="placard-actions">
              {p.data.agentMd && <AskButtons agentMd={p.data.agentMd} title={p.data.title} />}
              <GuidanceForm context={p.id} />
            </div>
          </article>
        ))}
      </div>
    )
  }

  <hr />

  <section class="about">
    <p class="eyebrow">About</p>
    <p>
      GregBenza.AI is where Greg highlights what he actually builds — a living log of
      projects, the methods behind them, and the runnable files underneath. It's here for
      three things: to show the work, to get feedback on it, and to get better by building
      in the open.
    </p>
    <p>
      Built agent-first: every placard carries a machine-readable record underneath, and
      the ask-more buttons connect one click into your own AI, prompts preloaded, so the
      work can be interrogated directly.
    </p>
  </section>
</Base>

<script>
  // Chips: unselected row = showing everything. Press one to narrow to that
  // project; press it again (or All) to widen back. State rides the URL.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const placards = Array.from(document.querySelectorAll<HTMLElement>('.placard'));

  function apply(selected: string) {
    chips.forEach((c) => {
      const active = selected === '' ? c.dataset.project === '' : c.dataset.project === selected;
      c.classList.toggle('is-active', active);
    });
    placards.forEach((card) => {
      card.style.display = selected === '' || card.dataset.project === selected ? '' : 'none';
    });
    const url = new URL(location.href);
    if (selected) url.searchParams.set('p', selected);
    else url.searchParams.delete('p');
    history.replaceState(null, '', url);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const target = chip.dataset.project ?? '';
      const already = chip.classList.contains('is-active');
      apply(already && target !== '' ? '' : target);
    });
  });

  apply(new URL(location.href).searchParams.get('p') ?? '');
</script>

<style>
  /* Quiet by design: the header already carries the brand, so the h1 states
     the page for machines and readers without shouting over the log. */
  .page-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-block: var(--space-3) 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: var(--space-3);
  }
  .chip {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.35em 1em;
    min-height: 2.2rem;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--accent-soft);
    color: var(--accent);
  }
  .chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block: var(--space-3) var(--space-5);
  }
  .placard {
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    /* Deliberately NOT overflow:hidden. It was clipping the ask-panel, which
       drops ~174px below the card — the buttons rendered but were invisible.
       The media rounds its own corners instead, so the card still looks sealed. */
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  .placard:hover {
    border-color: var(--ink-soft);
    box-shadow: 0 1px 6px rgba(26, 26, 26, 0.08);
  }
  .placard-link {
    display: block;
    text-decoration: none;
  }
  /* Compact placards on wide screens: media rides left, words right, several
     placards per screen. Stacks back to media-on-top on phones. */
  @media (min-width: 700px) {
    .placard-link {
      display: grid;
      grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
      align-items: stretch;
    }
    .placard-media {
      height: 100%;
      width: 100%;
      aspect-ratio: 16 / 9;
      max-height: 190px;
      /* Media sits on the left here, so it rounds the left corners. */
      border-radius: 5px 0 0 5px;
    }
    .placard-body {
      padding: var(--space-2) var(--space-3);
      align-self: center;
    }
    .placard-title {
      font-size: 1.1rem;
    }
    .placard-headline {
      font-size: 0.98rem;
      margin-top: 0.3rem;
    }
    .placard-tag {
      margin-top: 0.6rem;
    }
  }
  .placard-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0 var(--space-3) var(--space-2);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-2);
    margin-inline: 0;
  }
  .placard-actions :global(.ask-more) {
    display: contents;
  }
  .chip {
    white-space: nowrap;
  }
  .placard-media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--paper-edge);
    /* Stacked layout: media on top, so it rounds the top corners. 5px = the
       card's 6px radius minus its 1px border. */
    border-radius: 5px 5px 0 0;
  }
  .placard-body {
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  .placard-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .placard-title {
    font-size: 1.25rem;
    margin: 0;
    color: var(--ink);
  }
  .placard-top time {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .placard-headline {
    color: var(--ink-soft);
    margin: var(--space-1) 0 0;
    font-size: 1.05rem;
  }
  .placard-tag {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    border-radius: 999px;
    padding: 0.15em 0.7em;
  }
  .about p {
    color: var(--ink-soft);
  }
</style>
