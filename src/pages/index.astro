---
// TEMPORARY landing page. The real homepage is preserved at
// src/index.astro.original-backup — move it back here to restore the site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GregBenza.ai</title>
    <meta name="description" content="A place to post my fun AI based projects" />
    <meta name="google-site-verification" content="8603VMCvQNsi_EMf8otqhAfYyjfhl5rhE012ZNBFSCc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f6f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121216" />
    <style>
      :root {
        --bg: #f6f6f4;
        --ink: #1a1a1e;
        --muted: #55555e;
        --accent: #4f6df5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121216;
          --ink: #f2f2ef;
          --muted: #a3a3ad;
          --accent: #8ea2ff;
        }
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        height: 100%;
        overflow: hidden;
      }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 1.5rem;
      }
      h1 {
        font-size: clamp(2.5rem, 8vw, 5rem);
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }
      h1 .ai { color: var(--accent); }
      p {
        font-size: clamp(1.1rem, 3vw, 1.5rem);
        color: var(--muted);
        max-width: 32ch;
        margin-inline: auto;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>GregBenza<span class="ai">.ai</span></h1>
      <p>A place to post my fun AI based projects</p>
    </main>
  </body>
</html>
