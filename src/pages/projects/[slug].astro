---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import AskButtons from '../../components/AskButtons.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
// Part 3 — the full background story is the markdown body.
const { Content } = await render(project);

// Icon/label per technical-input kind. Kept here so the three-part skeleton
// renders identically for every project.
const kindLabel: Record<string, string> = {
  prompt: 'Prompt',
  skill: 'Skill',
  connector: 'Connector',
  input: 'Input',
  output: 'Output',
};
---

<Base title={`${data.title} — Greg Benza`} description={data.blurb}>
  <article
    class="project"
    data-accent={data.accent}
    style={data.accent ? `--accent:${data.accent}` : undefined}
  >
    <p class="eyebrow">
      <a href="/">← the log</a>
    </p>
    <h1>{data.title}</h1>
    <time datetime={data.date.toISOString()}>
      {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
    </time>

    {/* The headline — Greg's one-liner under the title. */}
    <p class="blurb">{data.blurb}</p>

    {/* Hero media — proves native rendering (image / video / clean YouTube). */}
    {data.hero && <Media {...data.hero} />}

    {/* The blurb — Greg's words under the picture. The markdown body. */}
    <section class="post-blurb">
      <div class="prose">
        <Content />
      </div>
    </section>

    {/* Ask-more: hand this post's markdown twin to the visitor's own AI. */}
    {data.agentMd && <AskButtons agentMd={data.agentMd} title={data.title} />}

    {/* The AI record — dry, identical fields on every placard. */}
    {
      data.record && (
        <section class="record" aria-label="The AI record">
          <h2>{data.expandLabel ?? 'Inputs, outputs, and prompts'}</h2>
          <dl>
            <dt>Problem</dt>
            <dd>{data.record.problem}</dd>
            <dt>What went in</dt>
            <dd>
              <ul>
                {data.record.wentIn.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
            <dt>What came back</dt>
            <dd>
              <ul>
                {data.record.cameBack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
            <dt>Outcome</dt>
            <dd>{data.record.outcome}</dd>
          </dl>
        </section>
      )
    }

    {/* Part 2 — technical details: the runnable inputs behind the work. */}
    {
      data.technical.length > 0 && (
        <section class="technical" aria-label="Technical details">
          <h2>Under the hood</h2>
          <p class="section-note">The inputs behind this — clickable, downloadable, runnable today.</p>
          <ul class="inputs">
            {data.technical.map((t) => (
              <li>
                <span class={`tag tag-${t.kind}`}>{kindLabel[t.kind] ?? t.kind}</span>
                <span class="input-body">
                  {t.file ? (
                    <a href={t.file} download>
                      {t.label}
                    </a>
                  ) : t.url ? (
                    <a href={t.url} rel="noopener">
                      {t.label}
                    </a>
                  ) : (
                    <span>{t.label}</span>
                  )}
                  {t.note && <span class="input-note">{t.note}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Outro media — the post plays out on the work itself. */}
    {data.outro && <Media {...data.outro} />}
  </article>
</Base>

<style>
  .project > time {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .blurb {
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-block: var(--space-3);
  }
  .record {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    margin-block: var(--space-3);
  }
  .record h2 { margin-top: var(--space-1); }
  .record dt {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: var(--space-2);
  }
  .record dd { margin: var(--space-1) 0 0; }
  .record dd ul { margin: 0; padding-left: 1.2em; }
  .record dd li { margin-bottom: 0.35em; }
  .technical {
    background: var(--paper-edge);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    margin-block: var(--space-3);
  }
  .technical h2 { margin-top: var(--space-1); }
  .section-note {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: 0;
  }
  .inputs { list-style: none; padding: 0; margin: 0; }
  .inputs li {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-1) 0;
    border-top: 1px solid var(--hairline);
  }
  .tag {
    flex: 0 0 auto;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink-soft);
    padding: 0.15em 0.5em;
    border-radius: var(--radius);
  }
  .tag-output { background: var(--accent); }
  .input-body { display: flex; flex-direction: column; }
  .input-note {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  /* Give the rendered background story comfortable rhythm. */
  .prose :global(h2) { border-top: none; }
</style>
