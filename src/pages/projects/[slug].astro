---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import AskButtons from '../../components/AskButtons.astro';
import GuidanceForm from '../../components/GuidanceForm.astro';
import { readQa } from '../../lib/qa';
import { SITE_URL, PERSON_ID, BLOG_ID, abs, person, blog, graph } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
// Part 3 — the full background story is the markdown body.
const { Content } = await render(project);

// Same flattening the layout does — folded YAML blurbs carry newlines, and
// structured data should hold the clean sentence a crawler will quote.
const blurb = data.blurb.replace(/\s+/g, ' ').trim();

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// Part 4 — the Q&A. Read back from this post's markdown twin so the questions
// have exactly one home and the HTML can't drift from what agents read.
const qa = await readQa(data.agentMd);

// Video posters follow the media naming convention (foo.web.mp4 → foo.poster.jpg).
const posterFor = (src: string) => src.replace(/\.web\.mp4$/, '.poster.jpg');

// What a shared link unfurls into: the hero if it's an image, its poster frame
// if it's a video, YouTube's thumbnail if it's an embed.
const socialImage =
  data.hero?.type === 'image'
    ? data.hero.src
    : data.hero?.type === 'video'
      ? posterFor(data.hero.src)
      : data.hero?.type === 'youtube'
        ? `https://i.ytimg.com/vi/${data.hero.src}/maxresdefault.jpg`
        : undefined;

const postUrl = `${SITE_URL}/projects/${project.id}/`;

// VideoObject for each self-hosted clip. Only local video: a YouTube embed's
// upload date and duration belong to YouTube, and we don't assert what we
// haven't measured. uploadDate is the post's date — when the clip went public
// on this site, which is what the field means here.
const videoNodes = [data.hero, data.outro, ...data.bodyMedia]
  .filter((m) => m?.type === 'video')
  .map((m) => ({
    '@type': 'VideoObject',
    name: m!.caption ?? data.title,
    description: m!.caption ?? blurb,
    contentUrl: abs(m!.src),
    thumbnailUrl: abs(posterFor(m!.src)),
    uploadDate: data.date.toISOString(),
    ...(m!.duration ? { duration: m!.duration } : {}),
    isPartOf: { '@id': `${postUrl}#post` },
  }));

const jsonLd = graph([
  person,
  blog,
  {
    // Both types are true of every post here: a dated blog entry AND a
    // technical write-up. Schema.org allows the pair; crawlers take the union.
    '@type': ['BlogPosting', 'TechArticle'],
    '@id': `${postUrl}#post`,
    headline: data.title,
    description: blurb,
    url: postUrl,
    mainEntityOfPage: postUrl,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': BLOG_ID },
    inLanguage: 'en',
    ...(data.project ? { keywords: data.project } : {}),
    ...(socialImage ? { image: [abs(socialImage)] } : {}),
    ...(videoNodes.length ? { video: videoNodes } : {}),
    // The machine-readable twin of this page — say out loud that it exists.
    ...(data.agentMd
      ? { encoding: { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: abs(data.agentMd) } }
      : {}),
  },
  ...videoNodes,
  // The Q&A pairs, machine-readable only. They were cut from the visible page
  // on 2026-07-29 (a post is one article, not an article plus its own echo),
  // but the extraction signal is the whole point of writing them — so they
  // ship here and in the agent-facing markdown instead of twice on screen.
  ...(qa.length
    ? [
        {
          '@type': 'FAQPage',
          '@id': `${postUrl}#faq`,
          about: { '@id': `${postUrl}#post` },
          mainEntity: qa.map((pair) => ({
            '@type': 'Question',
            name: pair.q,
            acceptedAnswer: { '@type': 'Answer', text: pair.a },
          })),
        },
      ]
    : []),
]);
---

<Base
  title={`${data.title} — Greg Benza`}
  description={data.blurb}
  image={socialImage}
  imageAlt={data.hero?.alt ?? data.hero?.caption}
  ogType="article"
  jsonLd={jsonLd}
>
  <article
    class="project"
    data-accent={data.accent}
    style={data.accent ? `--accent:${data.accent}` : undefined}
  >
    <p class="eyebrow">
      <a href="/">← the log</a>
    </p>

    {/* Ask-your-AI at the very top: the fastest way off the page for anyone
        who would rather have their own AI read the record than read this. */}
    {data.agentMd && <AskButtons agentMd={data.agentMd} title={data.title} />}

    <h1>{data.title}</h1>
    <p class="dateline">
      <time datetime={data.date.toISOString()}>{fmtDate(data.date)}</time>
      {/* Only shown once a published post has actually been revised — the
          freshness signal stays honest because it can't appear otherwise. */}
      {data.updated && (
        <>
          <span class="dateline-sep">·</span>
          <time class="updated" datetime={data.updated.toISOString()}>
            Updated {fmtDate(data.updated)}
          </time>
        </>
      )}
    </p>

    {/* The headline — Greg's one-liner under the title. */}
    <p class="blurb">{data.blurb}</p>

    {/* Hero media — proves native rendering (image / video / clean YouTube). */}
    {data.hero && <Media {...data.hero} />}

    {/* The blurb — Greg's words. The markdown body. */}
    <section class="post-blurb">
      <div class="prose">
        <Content />
      </div>
    </section>

    {/* The AI record — dry, identical fields on every placard. */}
    {
      data.record && (
        <section class="record" aria-label="The AI record">
          <h2>{data.expandLabel ?? 'Inputs, outputs, and prompts'}</h2>
          <dl>
            <dt>Problem</dt>
            <dd>{data.record.problem}</dd>
            <dt>What went in</dt>
            <dd>
              <ul>
                {data.record.wentIn.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
            <dt>What came back</dt>
            <dd>
              <ul>
                {data.record.cameBack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
            <dt>Outcome</dt>
            <dd>{data.record.outcome}</dd>
          </dl>
        </section>
      )
    }

    {/* The Q&A used to render here, restating the article a second time in a
        different voice. Greg cut it from the page on 2026-07-29: a post is one
        article, and the depth belongs in the markdown twin an AI fetches. The
        pairs still ship — as FAQPage structured data above, and in full in the
        agent-facing markdown the ask-buttons point at. */}

    {/* Part 2 — the files. Just a filename and what it is. The Prompt/Input/
        Output chips were cut on 2026-07-29: the taxonomy was furniture, and a
        reader wants the file's name and a line telling them what it does. The
        `kind` field stays in the schema — it still carries meaning for agents
        reading the collection — it simply isn't rendered as a badge. */}
    {
      data.technical.length > 0 && (
        <section class="technical" aria-label="Relevant files">
          <h2>Relevant files</h2>
          <ul class="inputs">
            {data.technical.map((t) => (
              <li>
                <span class="input-body">
                  {t.file ? (
                    <a href={t.file} download>
                      {t.label}
                    </a>
                  ) : t.url ? (
                    <a href={t.url} rel="noopener">
                      {t.label}
                    </a>
                  ) : (
                    <span>{t.label}</span>
                  )}
                  {t.note && <span class="input-note">{t.note}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Outro media — the post plays out on the work itself. */}
    {data.outro && <Media {...data.outro} />}

    {/* The feedback door, last: read the whole record, then say something. */}
    <GuidanceForm context={project.id} />
  </article>
</Base>

<style>
  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .dateline-sep {
    color: var(--hairline);
  }
  .updated {
    color: var(--ink-soft);
  }
  .qa {
    margin-block: var(--space-3);
  }
  .qa h2 {
    margin-bottom: var(--space-2);
  }
  .qa-item + .qa-item {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline);
  }
  .qa-q {
    margin: 0 0 var(--space-1);
    color: var(--ink);
  }
  .qa-a {
    margin: 0;
    color: var(--ink-soft);
  }
  .blurb {
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-block: var(--space-3);
  }
  .record {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    margin-block: var(--space-3);
  }
  .record h2 { margin-top: var(--space-1); }
  .record dt {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: var(--space-2);
  }
  .record dd { margin: var(--space-1) 0 0; }
  .record dd ul { margin: 0; padding-left: 1.2em; }
  .record dd li { margin-bottom: 0.35em; }
  .technical {
    background: var(--paper-edge);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    margin-block: var(--space-3);
  }
  .technical h2 { margin-top: var(--space-1); }
  .inputs { list-style: none; padding: 0; margin: 0; }
  .inputs li {
    display: flex;
    padding: var(--space-1) 0;
    border-top: 1px solid var(--hairline);
  }
  .input-body { display: flex; flex-direction: column; }
  .input-note {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  /* Give the rendered background story comfortable rhythm. */
  .prose :global(h2) { border-top: none; }
</style>
