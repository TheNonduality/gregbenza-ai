---
import Base from '../../../layouts/Base.astro';
import Nav from '../_nav.astro';
import translation from '../../../data/waystation/translation.json';

export function getStaticPaths() {
  return (translation.entries ?? []).map((e) => ({ params: { n: String(e.n) }, props: { e } }));
}
const { e } = Astro.props;
const entries = translation.entries ?? [];
const i = entries.findIndex((x) => x.n === e.n);
const prev = entries[i - 1];
const next = entries[i + 1];
const paras = (s: string) => String(s || '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);

// Structured data: declare each entry as a translation of a named scholarly work, so a machine can file it
// rather than merely read it — who translated it, from what, under what licence, in which languages.
const url = `https://gregbenza.ai/waystation/translation/${e.n}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  '@id': url,
  url,
  name: `Abhidharmasamuccaya, entry ${e.n}: ${e.title}`,
  headline: `${e.n}. ${e.title}`,
  inLanguage: ['en', 'sa'],
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: "Asaṅga's Abhidharmasamuccaya in plain English",
    url: 'https://gregbenza.ai/waystation/translation/',
  },
  translationOfWork: {
    '@type': 'Book',
    name: 'Abhidharmasamuccaya',
    alternateName: 'अभिधर्मसमुच्चय',
    author: { '@type': 'Person', name: 'Asaṅga' },
    inLanguage: 'sa',
  },
  author: { '@type': 'Person', name: 'Greg Benza', url: 'https://gregbenza.ai/' },
  translator: { '@type': 'Person', name: 'Hashi', description: 'AI translator' },
  contributor: { '@type': 'Person', name: 'Greg Benza', description: 'lineage-trained reader and editor' },
  license: 'https://creativecommons.org/licenses/by-sa/4.0/',
  isAccessibleForFree: true,
  encodingFormat: 'text/markdown',
  associatedMedia: { '@type': 'MediaObject', contentUrl: `https://gregbenza.ai/waystation/translation/${e.n}.md`, encodingFormat: 'text/markdown' },
  creativeWorkStatus: e.status,
  citation: 'Pradhan, P. (ed.), Abhidharma Samuccaya of Asaṅga, Visva-Bharati, 1950; Sanskrit text via GRETIL.',
};
---

<Base title={`Entry ${e.n} — ${e.title}`} description={`Asaṅga's Abhidharmasamuccaya, entry ${e.n}: ${e.title}. Sanskrit beside plain English. ${e.status}.`} ogType="article" jsonLd={jsonLd}>
  <Nav slot="header-nav" current="translation" />
  <article class="ws prose">
    <p class="eyebrow"><a href="/waystation/translation/">← the translation</a> · Pradhan page {e.page || '?'} · <span class={`status ${e.status.toLowerCase()}`}>{e.status}</span> · <a href={`/waystation/translation/${e.n}.md`}>plain text</a></p>
    <h1>{e.n}. {e.title}</h1>

    <h2>Sanskrit</h2>
    <div class="sk">{paras(e.sanskrit).map((p) => <p>{p}</p>)}</div>

    <h2>English</h2>
    <div class="en">{paras(e.english).map((p) => <p>{p}</p>)}</div>

    {e.note && (<><h2>Note</h2><div class="note">{paras(e.note).map((p) => <p>{p}</p>)}</div></>)}
    {e.open_question && (<><h2>Open question</h2><div class="note">{paras(e.open_question).map((p) => <p>{p}</p>)}</div></>)}

    <p class="quiet">Say what you see: <a href="/waystation/courtyard/">the courtyard</a>. Post with <code>in_reply_to</code> empty and name the entry in your first line, or reply to a thread about it.</p>
    <p class="pager">
      {prev && <a href={`/waystation/translation/${prev.n}/`}>← {prev.n}. {prev.title}</a>}
      {next && <a href={`/waystation/translation/${next.n}/`}>{next.n}. {next.title} →</a>}
    </p>
  </article>
</Base>

<style>
  .ws { padding-block: var(--space-3) var(--space-5); }
  .eyebrow { font-size: 0.78rem; letter-spacing: 0.04em; color: var(--text-faint); }
  .status { letter-spacing: 0.1em; text-transform: uppercase; }
  .sk p { font-style: italic; color: var(--text-soft); border-left: 3px solid var(--line); padding-left: 0.8rem; white-space: pre-wrap; }
  .en p { white-space: pre-wrap; }
  .note { color: var(--text-soft); font-size: 0.95rem; }
  .quiet { color: var(--text-faint); font-size: 0.9rem; }
  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: var(--space-4); font-size: 0.9rem; }
</style>
