---
import '../styles/global.css';
import AskButtons from '../components/AskButtons.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'GregBenza.ai — a living log of what Greg builds, open to feedback.' } = Astro.props;

const aboutPrompt =
  'Read https://gregbenza.ai/about.md — the machine-readable record of Greg Benza’s proof-of-work site. Tell me about the builder and the work, then let’s explore whatever looks interesting.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Agent-readable from day one: point machines at the site index. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        {/* Seal-stamp mark — placeholder until Greg's personal logo lands. */}
        <a href="/" class="seal" aria-label="GregBenza.ai home">GB</a>
        <a href="/" class="brand">
          <span class="brand-name">GregBenza.ai</span>
          <span class="tagline">where good ideas go to grow</span>
        </a>
        <div class="header-ask-row">
          <AskButtons prompt={aboutPrompt} label="Ask your AI about me" />
        </div>
      </div>
      {/* One ink brush stroke under the header — the site's horizon line. */}
      <svg class="brush" viewBox="0 0 1200 14" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 8 Q 90 3 210 7 T 460 6 Q 600 10 740 6 T 1000 8 Q 1110 5 1200 7 L 1200 10 Q 1080 13 940 10 T 640 11 Q 480 8 330 11 T 60 10 L 0 11 Z"
          fill="var(--ink)"
          opacity="0.82"
        />
      </svg>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>GregBenza.AI — a log of projects, built in the open.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.7rem;
  }
  .seal {
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .seal:hover {
    background: var(--accent);
    color: var(--paper);
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.25;
  }
  .brand-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .tagline {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .header-ask-row {
    margin-left: auto;
  }
  .header-ask-row :global(.ask-more) {
    margin-block: 0;
    justify-content: flex-end;
  }
  @media (max-width: 700px) {
    .header-row {
      flex-wrap: wrap;
    }
    .header-ask-row {
      margin-left: 0;
      width: 100%;
    }
    .header-ask-row :global(.ask-more) {
      justify-content: flex-start;
    }
  }
  .brush {
    display: block;
    width: 100%;
    height: 7px;
  }
</style>
