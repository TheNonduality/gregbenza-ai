---
import '../styles/global.css';
import AskButtons from '../components/AskButtons.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description?: string;
  /** Site-absolute path to the social preview image, e.g. /projects/x/hero.jpg */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** Structured-data nodes for this page. See src/lib/schema.ts. */
  jsonLd?: unknown;
}
const {
  title,
  description = 'GregBenza.ai — a living log of what Greg builds, open to feedback.',
  image,
  imageAlt,
  ogType = 'website',
  jsonLd,
} = Astro.props;

// Folded YAML blurbs arrive with newlines baked in. Meta tags are single-line
// values — a raw newline here ships a ragged description to every crawler and
// unfurl card, so flatten before anything else touches these strings.
const oneLine = (s: string) => s.replace(/\s+/g, ' ').trim();
const metaTitle = oneLine(title);
const metaDescription = oneLine(description);

// Canonical and Open Graph both need absolute URLs; Astro.site is the real
// domain (set in astro.config.mjs), so these resolve correctly in dev and prod.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image ? new URL(image, Astro.site).href : undefined;

const aboutPrompt =
  'Read https://gregbenza.ai/about.md — the machine-readable record of Greg Benza’s proof-of-work site. Tell me about the builder and the work, then let’s explore whatever looks interesting.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Agent-readable from day one: point machines at the site index. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter: what a shared link unfurls into. Without these a
         link pasted into Slack, iMessage, or X shows a bare URL. -->
    <meta property="og:site_name" content="GregBenza.AI" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {/* Big card only when there is a real image to fill it; otherwise the
        small card, which degrades honestly instead of showing a blank slab. */}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        {/* Seal-stamp mark — placeholder until Greg's personal logo lands. */}
        <a href="/" class="seal" aria-label="GregBenza.ai home">GB</a>
        <a href="/" class="brand">
          <span class="brand-name">GregBenza.ai</span>
          <span class="tagline">— where good ideas go to grow</span>
        </a>
        <div class="header-ask">
          <AskButtons prompt={aboutPrompt} collapsed summaryLabel="Ask your AI about me ↗" />
        </div>
      </div>
      {/* One ink brush stroke under the header — the site's horizon line. */}
      <svg class="brush" viewBox="0 0 1200 14" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 8 Q 90 3 210 7 T 460 6 Q 600 10 740 6 T 1000 8 Q 1110 5 1200 7 L 1200 10 Q 1080 13 940 10 T 640 11 Q 480 8 330 11 T 60 10 L 0 11 Z"
          fill="var(--ink)"
          opacity="0.82"
        />
      </svg>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>GregBenza.AI — a log of projects, built in the open.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.7rem;
  }
  .seal {
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .seal:hover {
    background: var(--accent);
    color: var(--paper);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: nowrap;
    text-decoration: none;
    line-height: 1.25;
  }
  .brand-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .header-row {
      gap: 0.6rem;
      padding-block: 0.35rem;
    }
    .seal {
      width: 1.9rem;
      height: 1.9rem;
      font-size: 0.75rem;
      border-width: 1.5px;
    }
    .brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      line-height: 1.15;
      min-width: 0;
      flex: 1 1 auto;
    }
    .brand-name {
      font-size: 1.05rem;
    }
    .tagline {
      font-size: 0.72rem;
      white-space: normal;
      max-width: 100%;
    }
  }
  .header-row {
    flex-wrap: nowrap;
    row-gap: 0.3rem;
  }
  /* One quiet button in the header; the platform pills unfold beneath it, so
     the top of a phone screen stays for the brand and the work. */
  .header-ask {
    margin-left: auto;
    position: relative;
    flex: 0 0 auto;
  }
  @media (max-width: 700px) {
    .header-ask :global(.ask-summary) {
      font-size: 0.72rem;
      padding: 0.25em 0.7em;
      min-height: 1.9rem;
    }
  }
  .brush {
    display: block;
    width: 100%;
    height: 7px;
  }
</style>
