---
import '../styles/global.css';
import AskButtons from '../components/AskButtons.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'GregBenza.ai — a living log of what Greg builds, open to feedback.' } = Astro.props;

const aboutPrompt =
  'Read https://gregbenza.ai/about.md — the machine-readable record of Greg Benza’s proof-of-work site. Tell me about the builder and the work, then let’s explore whatever looks interesting.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Agent-readable from day one: point machines at the site index. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        {/* Seal-stamp mark — placeholder until Greg's personal logo lands. */}
        <a href="/" class="seal" aria-label="GregBenza.ai home">GB</a>
        <a href="/" class="brand">
          <span class="brand-name">GregBenza.ai</span>
          <span class="tagline">— where good ideas go to grow</span>
        </a>
        <details class="header-ask">
          <summary class="header-ask-btn">Ask your AI about me</summary>
          <div class="header-ask-row">
            <AskButtons prompt={aboutPrompt} label="" />
          </div>
        </details>
      </div>
      {/* One ink brush stroke under the header — the site's horizon line. */}
      <svg class="brush" viewBox="0 0 1200 14" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 8 Q 90 3 210 7 T 460 6 Q 600 10 740 6 T 1000 8 Q 1110 5 1200 7 L 1200 10 Q 1080 13 940 10 T 640 11 Q 480 8 330 11 T 60 10 L 0 11 Z"
          fill="var(--ink)"
          opacity="0.82"
        />
      </svg>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>GregBenza.AI — a log of projects, built in the open.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.7rem;
  }
  .seal {
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .seal:hover {
    background: var(--accent);
    color: var(--paper);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: nowrap;
    text-decoration: none;
    line-height: 1.25;
  }
  .brand-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .header-row {
      gap: 0.6rem;
      padding-block: 0.35rem;
    }
    .seal {
      width: 1.9rem;
      height: 1.9rem;
      font-size: 0.75rem;
      border-width: 1.5px;
    }
    .brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      line-height: 1.15;
      min-width: 0;
      flex: 1 1 auto;
    }
    .brand-name {
      font-size: 1.05rem;
    }
    .tagline {
      font-size: 0.72rem;
      white-space: normal;
      max-width: 100%;
    }
  }
  .header-row {
    flex-wrap: nowrap;
    row-gap: 0.3rem;
  }
  /* One quiet button in the header; the platform pills unfold beneath it, so
     the top of a phone screen stays for the brand and the work. */
  .header-ask {
    margin-left: auto;
    position: relative;
    flex: 0 0 auto;
  }
  .header-ask-btn {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.3em 0.9em;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
  }
  .header-ask-btn::-webkit-details-marker {
    display: none;
  }
  .header-ask-btn:hover,
  .header-ask[open] .header-ask-btn {
    border-color: var(--accent);
    color: var(--accent);
  }
  .header-ask-row {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(26, 26, 26, 0.1);
  }
  .header-ask-row :global(.ask-more) {
    margin-block: 0;
    flex-wrap: nowrap;
  }
  @media (max-width: 560px) {
    .header-ask-btn {
      font-size: 0.72rem;
      padding: 0.25em 0.7em;
      min-height: 1.9rem;
    }
    .header-ask-row {
      right: 0;
      max-width: 92vw;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
  .brush {
    display: block;
    width: 100%;
    height: 7px;
  }
</style>
