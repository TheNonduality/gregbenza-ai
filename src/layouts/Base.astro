---
import '../styles/global.css';
import AskButtons from '../components/AskButtons.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description?: string;
  /** Site-absolute path to the social preview image, e.g. /projects/x/hero.jpg */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** Structured-data nodes for this page. See src/lib/schema.ts. */
  jsonLd?: unknown;
}
const {
  title,
  description = 'GregBenza.ai — a living log of what Greg builds, open to feedback.',
  image,
  imageAlt,
  ogType = 'website',
  jsonLd,
} = Astro.props;

// Folded YAML blurbs arrive with newlines baked in. Meta tags are single-line
// values — a raw newline here ships a ragged description to every crawler and
// unfurl card, so flatten before anything else touches these strings.
const oneLine = (s: string) => s.replace(/\s+/g, ' ').trim();
const metaTitle = oneLine(title);
const metaDescription = oneLine(description);

// Canonical and Open Graph both need absolute URLs; Astro.site is the real
// domain (set in astro.config.mjs), so these resolve correctly in dev and prod.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image ? new URL(image, Astro.site).href : undefined;

const aboutPrompt =
  'Read https://gregbenza.ai/about.md — the machine-readable record of Greg Benza’s proof-of-work site. Tell me about the builder and the work, then let’s explore whatever looks interesting.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <!-- Google Search Console ownership proof. Public by design and useless to
         anyone without control of the domain — not a credential. Google
         re-checks it, so it stays. -->
    <meta name="google-site-verification" content="8603VMCvQNsi_EMf8otqhAfYyjfhl5rhE012ZNBFSCc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Phone browser chrome matches the gallery wall in whichever theme the
         visitor's device is set to. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f6f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121216" />
    <!-- Marks the page as script-capable BEFORE first paint. Every hidden-until-
         revealed style is gated on `html.js`, so a visitor without JavaScript
         is never left staring at content that will now never fade in. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Agent-readable from day one: point machines at the site index. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter: what a shared link unfurls into. Without these a
         link pasted into Slack, iMessage, or X shows a bare URL. -->
    <meta property="og:site_name" content="GregBenza.AI" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {/* Big card only when there is a real image to fill it; otherwise the
        small card, which degrades honestly instead of showing a blank slab. */}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    {/* The wall the whole exhibit hangs on, holding the wing tint. A real fixed
        element and not the body background, because a body background gets
        propagated to the page canvas and a canvas background does not animate —
        the cross-fade between rooms was being dropped on the floor. */}
    <div class="wall" aria-hidden="true"></div>
    {/* Full-bleed slot, outside the reading column. Anything that has to touch
        both walls goes here — the alternative is a child escaping .wrap with
        100vw, which counts the scrollbar the content box does not and leaves the
        whole site scrolling ~8px sideways.

        IT SITS ABOVE THE HEADER ON PURPOSE, and that placement is the entire
        mechanism behind "the header only appears once you are through the door".
        A sticky element is in normal flow until its own position would scroll
        past the top — so a header placed after a 220vh door is simply not reached
        until the door is behind you, and then it pins and stays for the rest of
        the page. No hiding, no script, no reveal to get wrong: nothing is ever
        invisible-but-focusable, there is no layout shift, and it behaves
        identically with JavaScript off and with motion turned off (where the door
        is one screen tall, so the header arrives one screen in).
        Pages with nothing in this slot are unaffected — the header is still the
        first thing in the body and pins from the start.
        It also fixed a misalignment nobody had noticed: the door used to begin
        ~56px down the page while its scroll animation was measured from document
        zero, so the doorway finished opening slightly out of step with its own
        sticky run. Starting at zero puts them back in phase. */}
    <slot name="bleed" />
    <header class="site-header">
      <div class="wrap header-row">
        {/* No mark, by decision. The name set in the display face IS the
            identity — the one repeated glyph on this site is the ask-spark,
            which belongs to the agent handshake and nothing else. */}
        <a href="/" class="brand">
          <span class="brand-name">GregBenza<span class="brand-ai">.AI</span></span>
          <span class="tagline">— where good ideas go to grow</span>
        </a>
        <div class="header-ask">
          <AskButtons prompt={aboutPrompt} collapsed summaryLabel="Ask your AI about me ↗" />
        </div>
      </div>
      {/* The room list rides WITH the header rather than scrolling away up the
          page, so you can change rooms from anywhere in the exhibit. Guarded on
          the slot actually having content — otherwise every page without a room
          list would grow an empty ruled strip under the brand. */}
      {
        Astro.slots.has('header-nav') && (
          <div class="header-nav">
            <slot name="header-nav" />
          </div>
        )
      }
    </header>
    <main class="wrap">
      <slot />
    </main>
    {/* No footer. The line that used to sit here ("a log of projects, built in
        the open") was cut on 2026-07-29: the door already says what this place
        is, and the talk-back panel is a better last thing on the page than a
        restatement. The element went with the text rather than staying as an
        empty bordered strip. */}
    {/* Scroll progress. Pure garnish: a CSS scroll-driven animation where it is
        supported, and simply absent where it is not — nothing depends on it. */}
    <div class="scroll-progress" aria-hidden="true"></div>

    <script is:inline>
      // Publishes the sticky header's real height as --header-h, which
      // global.css turns into scroll-padding-top so nothing you jump to lands
      // underneath it. Measured rather than hard-coded because the header grows:
      // the brand row rewraps under 360px, and the room list can take a second
      // line once there are more rooms than fit. Watched, so it stays right
      // through rotation and resize.
      (() => {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const publish = () =>
          document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
        publish();
        // The first measurement happens before the web fonts land, and the header
        // grows a little when they do — so re-measure once they are ready and
        // again at load. Without these the offset stays a stale ~13px short and
        // the header still clips the top of whatever you jumped to.
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(publish);
        addEventListener('load', publish);
        if ('ResizeObserver' in window) new ResizeObserver(publish).observe(header);
        else addEventListener('resize', publish, { passive: true });
      })();
    </script>
  </body>
</html>

<style>
  /* A pane of glass over the wall: the wing tint showing through keeps the
     header part of the room rather than a bar sitting on top of it. Falls back
     to the flat wall colour where backdrop-filter is unsupported. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--ground);
    border-bottom: 1px solid var(--line);
    /* Follows the wall when the room changes instead of stepping to the new
       tint a beat ahead of it. */
    transition: background-color var(--dur-zone) ease;
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background-color: color-mix(in oklab, var(--zone, var(--ground)) 82%, transparent);
      backdrop-filter: blur(10px) saturate(1.4);
    }
  }
  /* The room list, second row of the header. Its pills are styled by whichever
     page supplies them; the header only draws the rule above the row and kills
     the standalone margins those pills carry when they are not in a header. */
  .header-nav {
    border-top: 1px solid var(--line);
  }
  .header-nav :global(.chips) {
    margin: 0;
    padding-block: 0.55rem;
  }
  /* Tighter on a phone, where this row is a permanent tenant of a small screen. */
  @media (max-width: 640px) {
    .header-nav :global(.chips) {
      padding-block: 0.35rem;
    }
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.7rem;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: nowrap;
    text-decoration: none;
    line-height: 1.25;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }
  /* The only place outside the ask controls that wears the agent cyan — it ties
     the name to what the site actually is. */
  .brand-ai {
    color: var(--ask);
  }
  .tagline {
    font-size: 1rem;
    color: var(--text-faint);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .header-row {
      gap: 0.6rem;
      padding-block: 0.4rem;
    }
    .brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      line-height: 1.15;
      min-width: 0;
      flex: 1 1 auto;
    }
    .brand-name {
      font-size: 1.05rem;
    }
    .tagline {
      font-size: 0.72rem;
      white-space: normal;
      max-width: 100%;
    }
  }
  .header-row {
    flex-wrap: nowrap;
    row-gap: 0.3rem;
  }
  /* Two places the row genuinely cannot fit on one line, so it grows a line
     instead and the ask pill drops beneath the brand.
       Under 360: the brand name alone needs more room than what is left beside
     the pill — measured, it runs out at 340 and the name starts overlapping
     the pill. The extra margin is for devices whose fonts render wider.
       641 to 700: the brand is still full size (that shrinks at 640) but the
     viewport is narrower than the row needs.
     Everywhere else the row fits and this does nothing.
     Re-measured after the seal was removed (2026-07-29): dropping the mark
     freed ~55px of row, but the display face sets the name wider than the old
     serif did, so both wrap points still earn their keep. */
  @media (max-width: 359px), (min-width: 641px) and (max-width: 700px) {
    .header-row {
      flex-wrap: wrap;
    }
  }
  /* One quiet button in the header; the platform pills unfold beneath it, so
     the top of a phone screen stays for the brand and the work. */
  .header-ask {
    margin-left: auto;
    position: relative;
    flex: 0 0 auto;
  }
  /* The pill stays compact until the column is wide enough to hold the full
     one. .wrap is clamped at the reading measure until 82vw overtakes it, so
     between 700 and 835 the column sits at its minimum while the full-size
     pill needs 12px more than it holds — the row used to hang over its own
     padding there. Compact through 835, full size once there is room. */
  @media (max-width: 835px) {
    .header-ask :global(.ask-summary) {
      font-size: 0.72rem;
      padding: 0.25em 0.7em;
      min-height: 1.9rem;
    }
  }
  /* Scroll progress. Only ever drawn where the browser can scrub it from the
     scroll position itself — no JavaScript, and no half-broken version. */
  .scroll-progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroll-progress {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 11;
        height: 3px;
        width: 100%;
        transform-origin: 0 50%;
        background: linear-gradient(90deg, var(--ask), var(--wing, var(--text)));
        animation: progress-grow linear both;
        animation-timeline: scroll(root block);
      }
      @keyframes progress-grow {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
    }
  }
</style>
